; Hello World
; Canvas: 400x300

; Background gradient (dark blue to purple)
SET_COLOR 20 10 40
RECT_FILL 0 0 400 300
SET_COLOR 30 15 60
RECT_FILL 0 50 400 200
SET_COLOR 25 12 50
RECT_FILL 0 100 400 100

; Decorative top bar
SET_COLOR 120 80 220
RECT_FILL 0 0 400 4

; Centered text box
SET_COLOR 40 25 80
RECT_FILL 60 100 280 80
SET_COLOR 120 80 220
RECT_FILL 60 100 280 2
RECT_FILL 60 178 280 2
RECT_FILL 60 100 2 80
RECT_FILL 338 100 2 80

; Main title
SET_COLOR 255 255 255
TEXT 110.0 148.0 "Hello, World!"

; Subtitle
SET_COLOR 160 140 200
TEXT 120.0 220.0 "GraphVM v0.1"

; Corner decorations
SET_COLOR 80 200 160
RECT_FILL 20 20 12 3
RECT_FILL 20 20 3 12
RECT_FILL 368 20 12 3
RECT_FILL 377 20 3 12
RECT_FILL 20 277 12 3
RECT_FILL 20 268 3 12
RECT_FILL 368 277 12 3
RECT_FILL 377 268 3 12

; Decorative bottom bar
SET_COLOR 80 200 160
RECT_FILL 0 296 400 4

END
